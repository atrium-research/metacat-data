<?xml version="1.0" encoding="UTF-8"?>
<generator_policy>
   <generator name="CollectionURI" prefix="atrium" shorten="yes" type="any">
      <pattern>Collection/{term}</pattern>
   </generator>
   <generator name="CollectionURI-2" prefix="atrium" shorten="yes" type="any">
      <pattern>Collection/{provider}/{term}</pattern>
   </generator>
   <generator name="DataResourceURI" prefix="atrium" shorten="yes" type="any">
      <pattern>Resource/{term}</pattern>
   </generator>
   <generator name="DataResourceURI-2"
              prefix="atrium"
              shorten="yes"
              type="any">
      <pattern>Resource/{provider}/{term}</pattern>
   </generator>
   <generator name="ObjectURI" prefix="atrium" shorten="yes" type="any">
      <pattern>Object/{resource}-{term}</pattern>
   </generator>
   <generator name="ObjectURI-2" prefix="atrium" shorten="yes" type="any">
      <pattern>Object/{arg1}/{arg2}</pattern>
   </generator>
   <generator name="ObjectLabel" type="any">
      <pattern>Resource {resource} is about object {term}</pattern>
   </generator>
   <generator name="IdentifierURI" prefix="atrium" type="any">
      <pattern>Identifier/{term}</pattern>
   </generator>
   <generator name="DocumentURI" prefix="atrium" shorten="yes" type="any">
      <pattern>Document/{term}</pattern>
   </generator>
   <generator name="DocumentURI-2" prefix="atrium" shorten="yes" type="any">
      <pattern>Document/{provider}/{term}</pattern>
   </generator>
   <generator name="EventURI" prefix="atrium" shorten="yes" type="any">
      <pattern>Event/{resource}-{term}</pattern>
   </generator>
   <generator name="EventURI-2" prefix="atrium" type="any">
      <pattern>Event/{arg1}/{arg2}</pattern>
   </generator>
   <generator name="EventURI-3" prefix="atrium" type="any">
      <pattern>Event/{arg1}/{arg2}/{arg3}</pattern>
   </generator>
   <generator name="EventLabel" type="any">
      <pattern>Resource {resource} is about event {term}</pattern>
   </generator>
   <generator name="Time-SpanURI" prefix="atrium" type="any">
      <pattern>Time-Span/{term}</pattern>
   </generator>
   <generator name="Time-SpanURI-short"
              prefix="atrium"
              shorten="yes"
              type="any">
      <pattern>Time-Span/{term}</pattern>
   </generator>
   <generator name="PlaceURI" prefix="atrium" shorten="yes" type="any">
      <pattern>Place/{term}</pattern>
   </generator>
   <generator name="PlaceURI-2" prefix="atrium" shorten="yes" type="any">
      <pattern>Place/{arg1}/{arg2}</pattern>
   </generator>
   <generator name="AgentURI" prefix="atrium" type="any">
      <pattern>Agent/{term}</pattern>
   </generator>
   <generator name="AgentURI-short" prefix="atrium" shorten="yes" type="any">
      <pattern>Agent/{term}</pattern>
   </generator>
   <generator name="PersonURI" prefix="atrium" type="any">
      <pattern>Person/{term}</pattern>
   </generator>
   <generator name="OrgURI" prefix="atrium" type="any">
      <pattern>Organisation/{term}</pattern>
   </generator>
   <generator name="ConceptURI" prefix="atrium" type="any">
      <pattern>Concept/{term}</pattern>
   </generator>
   <generator name="ConceptURI-2" prefix="atrium" type="any">
      <pattern>Concept/{scheme}/{term}</pattern>
   </generator>
   <generator name="ConceptURI-3" prefix="atrium" type="any">
      <pattern>Concept/{db}/{scheme}/{term}</pattern>
   </generator>
   <generator name="ConceptURI-2-short"
              prefix="atrium"
              shorten="yes"
              type="any">
      <pattern>Concept/{scheme}/{term}</pattern>
   </generator>
   <generator name="LangURI" prefix="lexvo" type="any">
      <pattern>{term}</pattern>
   </generator>
   <generator name="OneLevelCustomURI" prefix="atrium" type="any">
      <pattern>{level1}/{term}</pattern>
   </generator>
   <generator name="TwoLevelCustomURI" prefix="atrium" type="any">
      <pattern>{level1}/{level2}/{term}</pattern>
   </generator>
   <generator name="GraveURI-2" prefix="atrium" type="any">
      <pattern>Grave/{provider}/{term}</pattern>
   </generator>
   <generator name="BurialURI-2" prefix="atrium" type="any">
      <pattern>Burial/{provider}/{term}</pattern>
   </generator>
   <generator name="FindsURI-2" prefix="atrium" type="any">
      <pattern>Finds/{provider}/{term}</pattern>
   </generator>
   <generator name="SimpleLabel" type="any">
      <pattern>{label}</pattern>
   </generator>
   <generator name="CompositeLabel" type="any">
      <pattern>{label} {text}</pattern>
   </generator>
   <generator name="URIorUUID" type="any">
      <custom generatorClass="gr.forth.URIorUUID">
         <set-arg name="text"/>
      </custom>
   </generator>
   <generator name="URNfromTextualContent" type="any">
      <custom generatorClass="gr.forth.TextualContent">
         <set-arg name="text" type="xpath"/>
      </custom>
   </generator>
   <generator name="TypedLiteralGen" type="any">
      <custom generatorClass="gr.forth.TypedLiteralGenerator">
         <set-arg name="text"/>
      </custom>
   </generator>
   <generator name="ConcatMultipleTerms1" type="any">
      <custom generatorClass="gr.forth.ConcatMultipleTerms">
         <set-arg name="prefix" type="constant"/>
         <set-arg name="sameTermsDelim" type="constant"/>
         <set-arg name="diffTermsDelim" type="constant"/>
         <set-arg name="text1"/>
      </custom>
   </generator>
   <generator name="ServiceURI" prefix="atrium" shorten="yes" type="any">
      <pattern>Service/{term}</pattern>
   </generator>
   <generator name="ServiceURI-2" prefix="atrium" shorten="yes" type="any">
      <pattern>Service/{provider}/{term}</pattern>
   </generator>
   <generator name="SourceURI" prefix="atrium" type="instance" uuid="no">
      <pattern>Source/{term}</pattern>
   </generator>
</generator_policy>
